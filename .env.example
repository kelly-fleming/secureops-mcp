# Local stdio mode is the default. Relative database paths resolve from the process working directory.
SECUREOPS_MODE=local-full
SECUREOPS_DB_PATH=./data/secureops.db
SECUREOPS_LOG_LEVEL=info

# For the read-only HTTP demo, set SECUREOPS_MODE=http-demo and configure the entries below.
# SECUREOPS_HTTP_HOST=127.0.0.1
# SECUREOPS_HTTP_PORT=3000
# SECUREOPS_HTTP_ALLOW_PUBLIC_BIND=false
# SECUREOPS_HTTP_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Choose exactly one credential source. Generate your own random 32+ character token.
# SECUREOPS_HTTP_AUTH_TOKEN=<replace-with-a-random-token>
# SECUREOPS_HTTP_AUTH_TOKEN_FILE=<path-to-a-private-token-file>
